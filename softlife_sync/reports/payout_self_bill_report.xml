<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payout_self_bill" model="ir.actions.report">
        <field name="name">SoftLife Self-Billing Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">softlife_sync.report_payout_self_bill</field>
        <field name="report_file">softlife_sync.report_payout_self_bill</field>
        <field name="print_report_name">'Autofactura-%s' % (object.name or object.ref)</field>
    </record>

    <template id="report_payout_self_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="move">
                <t t-set="snapshot" t-value="move.softlife_payout_bill_snapshot"/>
                <t t-set="vendor" t-value="snapshot.get('vendor', {})"/>
                <t t-set="recipient" t-value="move.softlife_payout_recipient_snapshot"/>
                <div class="page" style="font-family: Arial, sans-serif; color: #261b17; font-size: 12px;">
                    <div style="border-bottom: 3px solid #b56545; padding-bottom: 12px; margin-bottom: 24px;">
                        <h1 style="margin: 0; font-size: 25px;">AUTOfactura</h1>
                        <div style="margin-top: 5px; font-size: 14px; font-weight: bold;">Facturación por el destinatario</div>
                        <div style="margin-top: 8px; color: #6b5d56;">Documento emitido por el destinatario en nombre y por cuenta del proveedor.</div>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                        <tr>
                            <td style="width: 50%; vertical-align: top; padding-right: 20px;">
                                <div style="font-size: 10px; font-weight: bold; text-transform: uppercase; color: #8b6d5f;">Proveedor / Emisor</div>
                                <div style="font-size: 16px; font-weight: bold; margin-top: 6px;"><t t-esc="vendor.get('legal_name')"/></div>
                                <div>NIF/CIF: <t t-esc="vendor.get('tax_id')"/></div>
                                <div><t t-esc="vendor.get('address_line_1')"/></div>
                                <div t-if="vendor.get('address_line_2')"><t t-esc="vendor.get('address_line_2')"/></div>
                                <div><t t-esc="vendor.get('postal_code')"/> <t t-esc="vendor.get('city')"/>, <t t-esc="vendor.get('province')"/> (ES)</div>
                                <div><t t-esc="vendor.get('email')"/></div>
                            </td>
                            <td style="width: 50%; vertical-align: top; padding-left: 20px; border-left: 1px solid #d8cec8;">
                                <div style="font-size: 10px; font-weight: bold; text-transform: uppercase; color: #8b6d5f;">Destinatario / Expedidor</div>
                                <div style="font-size: 16px; font-weight: bold; margin-top: 6px;"><t t-esc="recipient.get('legal_name')"/></div>
                                <div>NIF/CIF: <t t-esc="recipient.get('tax_id')"/></div>
                                <div><t t-esc="recipient.get('address_line_1')"/></div>
                                <div t-if="recipient.get('address_line_2')"><t t-esc="recipient.get('address_line_2')"/></div>
                                <div><t t-esc="recipient.get('postal_code')"/> <t t-esc="recipient.get('city')"/>, <t t-esc="recipient.get('province')"/> (<t t-esc="recipient.get('country_code')"/>)</div>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; background: #f4efe9;">
                        <tr>
                            <td style="padding: 10px;"><strong>Número:</strong> <t t-esc="move.name"/></td>
                            <td style="padding: 10px;"><strong>Fecha:</strong> <span t-field="move.invoice_date"/></td>
                            <td style="padding: 10px;"><strong>Periodo:</strong> <t t-esc="snapshot.get('period_month')"/></td>
                        </tr>
                        <tr>
                            <td colspan="3" style="padding: 0 10px 10px;"><strong>Referencia:</strong> <t t-esc="move.ref"/></td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
                        <thead>
                            <tr style="background: #392a24; color: white;">
                                <th style="text-align: left; padding: 10px;">Concepto</th>
                                <th style="text-align: right; padding: 10px;">Base imponible</th>
                                <th style="text-align: right; padding: 10px;">IVA</th>
                                <th style="text-align: right; padding: 10px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 12px 10px; border-bottom: 1px solid #d8cec8;"><t t-esc="snapshot.get('description')"/></td>
                                <td style="text-align: right; padding: 12px 10px; border-bottom: 1px solid #d8cec8;"><t t-esc="'%.2f EUR' % (snapshot.get('tax_base_cents', 0) / 100.0)"/></td>
                                <td style="text-align: right; padding: 12px 10px; border-bottom: 1px solid #d8cec8;">21% (<t t-esc="'%.2f EUR' % (snapshot.get('iva_cents', 0) / 100.0)"/>)</td>
                                <td style="text-align: right; padding: 12px 10px; border-bottom: 1px solid #d8cec8; font-weight: bold;"><t t-esc="'%.2f EUR' % (snapshot.get('gross_cents', 0) / 100.0)"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-left: auto; width: 42%; border: 2px solid #b56545; padding: 14px; text-align: right;">
                        <div>Base imponible: <strong><t t-esc="'%.2f EUR' % (snapshot.get('tax_base_cents', 0) / 100.0)"/></strong></div>
                        <div style="margin-top: 6px;">IVA 21%: <strong><t t-esc="'%.2f EUR' % (snapshot.get('iva_cents', 0) / 100.0)"/></strong></div>
                        <div style="margin-top: 10px; font-size: 17px;">Total: <strong><t t-esc="'%.2f EUR' % (snapshot.get('gross_cents', 0) / 100.0)"/></strong></div>
                    </div>

                    <div style="margin-top: 35px; padding-top: 12px; border-top: 1px solid #d8cec8; font-size: 9px; color: #6b5d56;">
                        <div>Contrato aceptado: <t t-esc="snapshot.get('contract_version')"/> · Evidencia: <t t-esc="snapshot.get('contract_acceptance_id')"/></div>
                        <div>Liquidación SoftLife: <t t-esc="snapshot.get('settlement_id')"/> · Documento: <t t-esc="snapshot.get('platform_bill_id')"/></div>
                        <div>La remuneración total indicada ya incluye el IVA. No se añade IVA adicional al importe pagadero.</div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
