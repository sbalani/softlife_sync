<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_softlife_manufacturing_run_list" model="ir.ui.view">
        <field name="name">softlife.manufacturing.run.list</field>
        <field name="model">softlife.manufacturing.run</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="document_date"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="time_zone"/>
                <field name="initiated_by"/>
                <field name="platform_status"/>
                <field name="processing_state"/>
                <field name="export_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_softlife_manufacturing_run_form" model="ir.ui.view">
        <field name="name">softlife.manufacturing.run.form</field>
        <field name="model">softlife.manufacturing.run</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_confirm_platform" type="object" string="Confirm"
                            class="btn-primary" invisible="initiated_by != 'odoo' or platform_status != 'draft'"/>
                    <button name="action_process" type="object" string="Process"
                            class="btn-primary" invisible="platform_status not in ('ready', 'failed') or processing_state in ('processing', 'result_pending', 'completed')"/>
                    <button name="action_retry_callback" type="object" string="Send / Retry Result"
                            invisible="processing_state != 'result_pending'"/>
                    <field name="processing_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="export_id"/>
                            <field name="idempotency_key"/>
                            <field name="initiated_by"/>
                            <field name="platform_status"/>
                        </group>
                        <group>
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="time_zone"/>
                            <field name="document_date"/>
                            <field name="payload_sha256"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview"><field name="payload" widget="json" nolabel="1"/></page>
                        <page string="Blocked Details"><field name="blocked_items" widget="json" nolabel="1"/></page>
                        <page string="Result"><field name="result_payload" widget="json" nolabel="1"/></page>
                        <page string="Errors">
                            <field name="error" nolabel="1"/>
                            <field name="callback_error" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_softlife_manufacturing_runs" model="ir.actions.act_window">
        <field name="name">Manufacturing Runs</field>
        <field name="res_model">softlife.manufacturing.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_softlife_manufacturing_refresh" model="ir.actions.server">
        <field name="name">Refresh Manufacturing Runs</field>
        <field name="model_id" ref="model_softlife_manufacturing_run"/>
        <field name="state">code</field>
        <field name="code">model.action_refresh(); action = {'type': 'ir.actions.client', 'tag': 'reload'}</field>
    </record>

    <record id="view_softlife_manufacturing_period_wizard" model="ir.ui.view">
        <field name="name">softlife.manufacturing.period.wizard.form</field>
        <field name="model">softlife.manufacturing.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Manufacturing Period">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="time_zone"/>
                </group>
                <footer>
                    <button name="action_prepare" type="object" string="Create Preview" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_softlife_manufacturing_period_wizard" model="ir.actions.act_window">
        <field name="name">Create Manufacturing Period</field>
        <field name="res_model">softlife.manufacturing.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
