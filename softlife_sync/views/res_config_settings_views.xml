<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_sync" model="ir.ui.view">
            <field name="name">res.config.settings.form.softlife_sync</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="SoftLife Sync" string="SoftLife Sync" name="softlife_sync">
                        <block title="Platform Connection" name="softlife_sync_conn">
                            <setting id="softlife_url" string="Supabase URL">
                                <field name="softlife_supabase_url"/>
                            </setting>
                            <setting id="softlife_key" string="Service Role Key">
                                <field name="softlife_supabase_key"/>
                            </setting>
                            <setting id="softlife_platform_url" string="Platform App URL"
                                     help="Application origin, for example https://app.softlife.example. Distinct from Supabase.">
                                <field name="softlife_platform_url" placeholder="https://app.example.com"/>
                            </setting>
                            <setting id="softlife_odoo_secret" string="Odoo Sync Secret">
                                <field name="softlife_odoo_sync_secret" password="True"/>
                            </setting>
                            <setting id="softlife_vending_customer" string="Vending Customer / Consumidor Final"
                                     help="Accounting customer used on Sales Orders created by manufacturing runs.">
                                <field name="softlife_default_partner_id"/>
                            </setting>
                            <setting id="softlife_fiscal_reporting" string="Fiscal configuration reporting"
                                     help="Off by default. When enabled, sends one read-only configuration report per hour. It cannot create or post invoices.">
                                <field name="softlife_fiscal_reporting_enabled"/>
                            </setting>
                            <setting id="softlife_fiscal_product_remediation"
                                     string="Allow platform-requested fiscal product configuration repairs"
                                     help="Off by default. Allows validated platform requests to repair only existing SoftLife product income accounts and sales taxes. This is separate from read-only reporting.">
                                <field name="softlife_fiscal_product_remediation_enabled"/>
                            </setting>
                            <setting id="softlife_fiscal_invoice_draft_creation"
                                     string="Allow platform-requested fiscal invoice draft creation"
                                     help="Off by default. Allows exact, validated batches to create only draft customer invoices.">
                                <field name="softlife_fiscal_invoice_draft_creation_enabled"/>
                            </setting>
                            <setting id="softlife_fiscal_invoice_confirmation"
                                     string="Allow platform-requested fiscal invoice confirmation"
                                     help="Off by default. Allows exact, validated batches to post only explicitly listed SoftLife fiscal invoices.">
                                <field name="softlife_fiscal_invoice_confirmation_enabled"/>
                            </setting>
                            <setting id="softlife_fiscal_company" string="Fiscal issuing company"
                                     help="Choose the legal entity that owns VEND and will issue the vending invoices.">
                                <field name="softlife_fiscal_company_id" options="{'no_create': True}"/>
                            </setting>
                            <setting id="softlife_payout_draft" string="Allow payout self-bill draft creation"
                                     help="Off by default. Allows validated payout requests to create exact vendor-bill drafts.">
                                <field name="softlife_payout_bill_draft_creation_enabled"/>
                            </setting>
                            <setting id="softlife_payout_post" string="Allow payout self-bill posting"
                                     help="Off by default. Allows only the dedicated payout handler to post an exact self-bill draft.">
                                <field name="softlife_payout_bill_posting_enabled"/>
                            </setting>
                            <setting id="softlife_payout_pdf" string="Allow payout self-bill PDF export"
                                     help="Off by default. Renders the posted vendor bill and uploads its raw PDF to the platform.">
                                <field name="softlife_payout_bill_pdf_export_enabled"/>
                            </setting>
                            <setting id="softlife_payout_company" string="Payout self-billing company">
                                <field name="softlife_payout_company_id" options="{'no_create': True}"/>
                            </setting>
                            <setting id="softlife_payout_journal" string="Payout purchase journal">
                                <field name="softlife_payout_purchase_journal_id"
                                       domain="[('type', '=', 'purchase'), ('company_id', '=', softlife_payout_company_id)]"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting id="softlife_payout_product" string="Payout expense product">
                                <field name="softlife_payout_expense_product_id"
                                       domain="[('purchase_ok', '=', True)]" options="{'no_create': True}"/>
                            </setting>
                            <setting id="softlife_payout_tax" string="Payout purchase IVA"
                                     help="Must be the product's active, price-included 21% purchase tax.">
                                <field name="softlife_payout_purchase_tax_id"
                                       domain="[('type_tax_use', '=', 'purchase'), ('amount_type', '=', 'percent'), ('amount', '=', 21), ('price_include', '=', True), ('company_id', '=', softlife_payout_company_id)]"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting id="softlife_last" string="Last sync">
                                <field name="softlife_last_sync" readonly="1"/>
                                <field name="softlife_last_sync_summary" readonly="1"/>
                            </setting>
                            <setting id="softlife_btn">
                                <button name="action_sync_now" type="object"
                                        string="Sync now" class="btn-primary"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
