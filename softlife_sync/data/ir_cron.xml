<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_softlife_sync" model="ir.cron">
            <field name="name">SoftLife: platform sync</field>
            <field name="model_id" ref="model_softlife_sync_client"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_softlife_manufacturing" model="ir.cron">
            <field name="name">SoftLife: manufacturing sync</field>
            <field name="model_id" ref="model_softlife_manufacturing_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_manufacturing()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
